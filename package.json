{
  "name": "coolhand-node",
  "version": "0.1.0",
  "description": "Monitor and LLM API calls for analysis",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "monitoring",
    "analytics",
    "api",
    "logging"
  ],
  "author": "Michael Carroll",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikecarroll/coolhand-node.git"
  },
  "bugs": {
    "url": "https://github.com/mikecarroll/coolhand-node/issues"
  },
  "homepage": "https://github.com/mikecarroll/coolhand-node#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node test/test.js",
    "test:ts": "npm run build && node -r ts-node/register test-ts/test.ts",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "example": "node examples/basic.js"
  },
  "devDependencies": {
    "openai": "^4.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0"
  }
}