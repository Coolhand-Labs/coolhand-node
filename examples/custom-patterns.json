{
  "patterns": [
    {
      "name": "OpenAI",
      "domains": ["openai.com", "api.openai.com"],
      "paths": ["/v1/chat/completions", "/v1/completions", "/v1/embeddings"],
      "headers": {
        "authorization": "[REDACTED]",
        "openai-api-key": "[REDACTED]"
      }
    },
    {
      "name": "Anthropic",
      "domains": ["api.anthropic.com"],
      "paths": ["/v1/messages", "/v1/complete"],
      "headers": {
        "x-api-key": "[REDACTED]"
      }
    },
    {
      "name": "Custom Provider",
      "domains": ["my-custom-ai-api.com"],
      "paths": ["/api/v1/generate", "/api/v1/models"],
      "headers": {
        "api-token": "[REDACTED]"
      }
    }
  ]
}